# Aplicação
APP_URL=https://n8n-insta-auto.fgxtfw.easypanel.host
APP_TIMEZONE=America/Sao_Paulo
ADMIN_PASSWORD=use-uma-senha-forte-com-mais-de-10-caracteres
SESSION_SECRET=gere-uma-chave-aleatoria-com-pelo-menos-32-caracteres
INTERNAL_API_SECRET=gere-outra-chave-aleatoria-com-pelo-menos-32-caracteres
PRIVACY_CONTACT_EMAIL=seu-email@dominio.com

# PostgreSQL do EasyPanel
DATABASE_URL=postgresql://usuario:senha@postgres:5432/instagram_auto
DATABASE_SSL=false

# Meta / Instagram Login
META_API_VERSION=v25.0
# O projeto aceita INSTAGRAM_CLIENT_ID ou INSTAGRAM_APP_ID.
INSTAGRAM_CLIENT_ID=
INSTAGRAM_APP_SECRET=
WEBHOOK_VERIFY_TOKEN=

# Criptografia do token armazenado no banco.
# Deve ser Base64 de exatamente 32 bytes. Gere com: openssl rand -base64 32
TOKEN_ENCRYPTION_KEY=

# Limites conservadores
MAX_MESSAGES_PER_HOUR=200
WORKER_INTERVAL_MS=500
QUEUE_CLAIM_TIMEOUT_MINUTES=10
